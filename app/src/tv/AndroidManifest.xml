<?xml version="1.0" encoding="utf-8"?>
<!-- Yumeiro TV: merged over src/main. Leanback launcher + banner, no touchscreen, no PiP. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Stated here too (main has it): TV boxes have no touchscreen; Play filters on it (G12 X10-3). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- No Android cloud backup: Yumeiro's own backup (Settings, Backup, storage & reset) covers it. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        tools:ignore="MissingTvBanner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="false"
            android:screenOrientation="landscape"
            tools:replace="android:supportsPictureInPicture">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
