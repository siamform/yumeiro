<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material Components theme so CloudStream extensions can show their own settings dialogs
         (AppCompat / Material views). The app UI itself is Jetpack Compose and draws its own theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#1DB954</item>
        <item name="colorPrimaryVariant">#169C46</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">#1DB954</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
