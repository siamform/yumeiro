<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 9 – 11. Updater state is device-specific and never backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="mt_updater.xml" />
    <!-- Account tokens (AniList / MyAnimeList) and API keys never leave the device. -->
    <exclude domain="sharedpref" path="online_secrets.xml" />
</full-backup-content>
