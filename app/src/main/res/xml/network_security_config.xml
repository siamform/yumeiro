<?xml version="1.0" encoding="utf-8"?>
<!--
  Many IPTV / camera streams are served over plain HTTP, so user-entered stream URLs may use
  cleartext. Only system CAs are trusted (no user-installed CAs), plus Let's Encrypt's ISRG Root X1:
  Android 7.0 (API 24, many TV boxes) predates it, and without it every Let's Encrypt site fails
  there. Newer Android already ships the same root, so this changes nothing on them. The in-app updater and
  subtitle search only ever use HTTPS endpoints (enforced in code).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">opensubtitles.org</domain>
        <domain includeSubdomains="true">opensubtitles.com</domain>
        <domain includeSubdomains="true">subdl.com</domain>
        <domain includeSubdomains="true">subsource.net</domain>
        <domain includeSubdomains="true">simkl.com</domain>
        <domain includeSubdomains="true">audioscrobbler.com</domain>
        <domain includeSubdomains="true">last.fm</domain>
        <domain includeSubdomains="true">lrclib.net</domain>
        <domain includeSubdomains="true">yumeiro.click</domain>
    </domain-config>
</network-security-config>
