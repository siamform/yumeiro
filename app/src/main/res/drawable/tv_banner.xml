<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 Android TV launcher banner -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="315" android:startColor="#FF23232B" android:endColor="#FF0B0B0E" />
        </shape>
    </item>
    <item android:width="150dp" android:height="150dp" android:gravity="center" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
