<?xml version="1.0" encoding="utf-8"?>
<!-- Yumeiro video surface. Round 13: SurfaceView variant (Settings → Quality and audio → Video renderer). Lowest power, but it does not follow Compose
     scale / translate / clip (swipe-down, floating and docked players) and never stays black
     after a dialog or the source picker closes on top of it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/black" />
