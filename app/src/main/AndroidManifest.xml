<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions — each one is required by a concrete feature. Nothing else is requested.
    -->

    <!-- Read local music / videos (Android 13+ granular media permissions) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Read local media on Android 9 – 12 only -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Media playback notification + "update ready" notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Background audio playback via Media3 MediaSessionService -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- App lock: BiometricPrompt / BiometricManager require it (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- One-tap "let Yumeiro run in the background" so new-episode notifications aren't killed by
         Doze / OEM battery savers (Yumeiro has no push server). Distributed outside Play. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Equalizer, bass boost and virtualizer audio effects -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- In-app updater: talk to GitHub Releases and hand the verified APK to the system installer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local network: DLNA / media-server discovery and Watch together on the same Wi-Fi need a
         multicast lock (SSDP/mDNS). No location or Wi-Fi scanning is used. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Updates always ask: the PackageInstaller session sets USER_ACTION_REQUIRED and the update
         download shows its DownloadManager notification (DOWNLOAD_WITHOUT_NOTIFICATION was removed
         in the v1.5.1 security review). -->

    <!-- Declared by Media3 only to refine its initial bandwidth estimate. Adaptive streams still
         adapt from measured throughput without it, so it is removed to keep permissions minimal. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Online downloads run as a foreground data-sync job (WorkManager) with a progress notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android TV: installable on TVs (Leanback launcher), works without a touchscreen -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- External download managers (Settings → Downloads → Download with): only these packages are
         looked up, so Yumeiro can list the ones installed without asking for all-apps visibility. -->
    <queries>
        <package android:name="idm.internet.download.manager.plus" />
        <package android:name="idm.internet.download.manager" />
        <package android:name="idm.internet.download.manager.adm.lite" />
        <package android:name="com.dv.adm" />
        <package android:name="com.dv.adm.pay" />
        <package android:name="com.dv.adm.old" />
    </queries>

    <application
        android:name=".MTApplication"
        android:banner="@drawable/tv_banner"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- AniList / MyAnimeList sign-in redirects -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yumeiro" android:host="anilist-login" />
                <data android:scheme="yumeiro" android:host="mal-login" />
            </intent-filter>

            <!-- "Open with Yumeiro": local videos -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- Network streams by MIME type (HLS / DASH / Smooth / any video) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/x-mpegurl" />
                <!-- Media3 / many IPTV apps send this exact mixed-case type; matching is case-sensitive. -->
                <data android:mimeType="application/x-mpegURL" tools:ignore="AppLinkUrlError" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
                <data android:mimeType="application/dash+xml" />
                <data android:mimeType="application/vnd.ms-sstr+xml" />
            </intent-filter>
            <!-- Network streams by file extension -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.m3u8" />
                <data android:pathPattern=".*\\.mpd" />
                <data android:pathPattern=".*\\.ts" />
                <data android:pathPattern=".*\\.mp4" />
                <data android:pathPattern=".*\\.mkv" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rtsp" />
                <data android:scheme="rtsps" />
            </intent-filter>
            <!-- Share a link to the app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- MediaSessionService for background audio playback and system media notifications.
             Exported so system UI / Bluetooth / Android Auto media controllers can connect. -->
        <service
            android:name=".service.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Background playback for videos (wraps the on-screen player). -->
        <service
            android:name=".service.VideoPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Updater: DownloadManager completion. Must be exported because the broadcast comes from
             the system DownloadProvider; the payload is validated against our own download id. -->
        <receiver
            android:name=".update.DownloadCompleteReceiver"
            android:exported="true"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Updater: PackageInstaller session result (explicit PendingIntent, not exported). -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Posts "Updated to vX" after a seamless background update replaced the app -->
        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- UnifiedPush (optional): the distributor app (e.g. ntfy) wakes the background checks.
             Bound only by the connector library inside this app (PushService checks the caller uid). -->
        <service
            android:name=".notify.PushWakeService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Instant notices (Firebase Cloud Messaging). Bound only by Google Play services; see
             docs/PUSH-FCM.md. FID registration (no legacy tokens), no auto-init until the app opts in,
             no Analytics. The app builds every notification itself from data messages. -->
        <service
            android:name=".notify.YumeiroMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />
        <!-- Messages typed in the Firebase console while the app is closed use these. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="yumeiro_news_v3" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_yumeiro" />

        <!-- Home-screen widget: continue watching -->
        <receiver
            android:name=".widget.ContinueWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue_info" />
        </receiver>

        <!-- Chromecast (Google's default media receiver) -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="dev.asfakul.yumeiro.cast.CastOptionsProvider" />

        <!-- WorkManager's foreground service, typed for downloads -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
