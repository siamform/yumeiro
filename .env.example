# Example environment for local release builds. Copy to .env (git-ignored) and export before running Gradle.
# All values below are FAKE. Never commit a real .env.
MT_KEYSTORE_PATH=/absolute/path/to/release.jks
MT_KEYSTORE_PASSWORD=fake-store-password
MT_KEY_ALIAS=fake-alias
MT_KEY_PASSWORD=fake-key-password
# Optional OAuth client IDs (public identifiers, not secrets)
ANILIST_CLIENT_ID=00000
MAL_CLIENT_ID=0000000000000000
# Optional trackers (build-time only, never commit real values)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
KITSU_CLIENT_ID=
KITSU_CLIENT_SECRET=
# Leave empty while the repository is public: anything set here is extractable from the APK.
MT_UPDATER_TOKEN=
