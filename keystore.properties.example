# Copy to keystore.properties (git-ignored) to build signed release APKs locally.
# Use the SAME constant release keystore as CI — never create a new one, or updates will fail.
storeFile=/absolute/path/to/mtplayer-release.jks
storePassword=CHANGE_ME
keyAlias=mtplayer
keyPassword=CHANGE_ME

# Optional: read-only GitHub token so the in-app updater works with a private repository.
# WARNING: a token set here is embedded in the APK and can be extracted. Leave unset while the repo is public.
# updaterToken=github_pat_xxx
