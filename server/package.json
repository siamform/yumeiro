{
  "name": "yumeiro-cloud",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute yumeiro --remote --file=schema.sql",
    "db:migrate:fcm": "wrangler d1 execute yumeiro --remote --file=migrations/0002_fcm_devices.sql",
    "db:migrate:guards": "wrangler d1 execute yumeiro --remote --file=migrations/0003_abuse_guards.sql",
    "db:migrate:want": "wrangler d1 execute yumeiro --remote --file=migrations/0004_fcm_want.sql",
    "db:migrate:fcm-follows": "wrangler d1 execute yumeiro --remote --file=migrations/0005_fcm_follows.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
